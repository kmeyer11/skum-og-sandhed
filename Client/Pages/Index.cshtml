@page
@model IndexModel

<header class="pour">
    <div class="bubbles" aria-hidden="true"></div>
    <img class="badge" src="~/img/roeverne-maerke.svg" alt="Røverne, Skum og Sandhed" width="200" height="200">
    <p>Røverne præsenterer</p>
    <h1>Skum og Sandhed</h1>
    <p class="lede">Hver øl vi har åbnet, hvad vi syntes, og hvad resten af verden syntes på Untappd.</p>
</header>

<main class="archive">
    <div class="tools">
        <h2>Arkivet <small id="beerCount"></small></h2>
        <input id="beerSearch" class="search" type="search" placeholder="Søg i navn, bryggeri eller type" aria-label="Søg">
    </div>
    <div class="table-wrap">
        <table id="beerTable">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Bryg år</th>
                    <th>Druk år</th>
                    <th class="num">ABV</th>
                    <th>Gæring</th>
                    <th>Gærtype</th>
                    <th class="num">Pris</th>
                    <th>Røverne / Untappd</th>
                </tr>
            </thead>
        </table>
    </div>
</main>

<dialog id="beerModal" class="beer" aria-labelledby="beerModalLabel">
    <div class="d-head">
        <button type="button" class="d-close" aria-label="Luk">×</button>
        <h3 id="beerModalLabel"></h3>
        <p id="beerBreweries"></p>
    </div>
    <div class="d-body">
        <blockquote id="beerDescription"></blockquote>
        <dl class="facts" id="beerFacts"></dl>
        <dl class="ing" id="beerIngredients"></dl>
    </div>
</dialog>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
    $(function () {
        var esc = s => $('<div>').text(s ?? '').html();
        var num = (n, digits) => n.toLocaleString('da-DK', { minimumFractionDigits: digits, maximumFractionDigits: 2 });
        // Arket giver 0 for tomme celler, så 0 betyder "ikke udfyldt" og vises som en streg.
        var orDash = (n, fmt) => n ? fmt(n) : '–';
        var kr = n => orDash(n, v => num(v, 0) + ' kr');
        var pct = n => orDash(n, v => num(v, 1) + ' %');
        var rating = n => orDash(n, v => num(v, 1));
        var year = n => orDash(n, v => v);
        var text = s => s ? esc(s) : '–';

        function glass(cls, v) {
            var fill = Math.min(Math.max(v / 5, 0), 1) * 100;
            return `<span class="glass ${cls}"><i style="--h:${fill}%"></i>${rating(v)}</span>`;
        }

        $.fn.dataTable.ext.errMode = 'none';

        var table = $('#beerTable').DataTable({
            ajax: { url: '/api/beers', dataSrc: '' },
            dom: 't<"dt-foot"ip>',
            pageLength: 25,
            order: [[7, 'desc']],
            language: {
                info: 'Viser _START_–_END_ af _TOTAL_',
                infoEmpty: 'Ingen øl',
                infoFiltered: '(fundet blandt _MAX_)',
                zeroRecords: 'Ingen øl matcher søgningen.',
                emptyTable: 'Arket er tomt.',
                loadingRecords: 'Henter øl fra arket…',
                paginate: { previous: 'Forrige', next: 'Næste' }
            },
            columns: [
                {
                    data: 'name', className: 'name',
                    render: (d, type, r) => type === 'display'
                        ? `${esc(d)}<span>${esc(r.breweries.join(' & '))}</span>`
                        : type === 'filter' ? [d, ...r.breweries, ...r.types].join(' ') : d
                },
                { data: 'releaseYear', render: (d, type) => type === 'display' ? year(d) : d },
                { data: 'drinkingYear', render: (d, type) => type === 'display' ? year(d) : d },
                { data: 'abv', className: 'num', render: (d, type) => type === 'display' ? pct(d) : d },
                { data: 'fermentation', render: (d, type) => type === 'display' ? text(d) : d },
                { data: 'yeastType', render: (d, type) => type === 'display' ? text(d) : d },
                { data: 'price', className: 'num', render: (d, type) => type === 'display' ? kr(d) : d },
                {
                    data: 'rating',
                    render: (d, type, r) => type === 'display'
                        ? `<span class="glasses">${glass('r', d)}${glass('u', r.untappdRating)}</span>`
                        : d
                }
            ],
            createdRow: row => { row.tabIndex = 0; },
            drawCallback: function () {
                $('#beerCount').text(this.api().page.info().recordsDisplay + ' øl');
            }
        });

        table.on('error.dt', function () {
            $('#beerTable tbody').html('<tr><td colspan="8" class="dataTables_empty">Kunne ikke hente øl fra arket. Genindlæs siden, eller tjek at Google-arket er delt med service accounten.</td></tr>');
        });

        $('#beerSearch').on('input', function () { table.search(this.value).draw(); });

        var dialog = document.getElementById('beerModal');

        function tags(list, cls) {
            return list.length
                ? list.map(x => `<span class="tag ${cls || ''}">${esc(x)}</span>`).join('')
                : '<span class="none">Ingen</span>';
        }

        function openBeer(data) {
            $('#beerModalLabel').text(data.name);
            $('#beerBreweries').text(data.breweries.join(' & '));
            $('#beerDescription').text(data.description ?? '');
            $('#beerFacts').html([
                ['Røvernes rating', rating(data.rating)], ['Untappd', rating(data.untappdRating)],
                ['ABV', pct(data.abv)], ['Pris', kr(data.price)],
                ['Brygget', year(data.releaseYear)], ['Drukket', year(data.drinkingYear)],
                ['Gæring', text(data.fermentation)], ['Gærtype', text(data.yeastType)]
            ].map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join(''));
            $('#beerIngredients').html(`
                <dt>Typer</dt><dd>${tags(data.types)}</dd>
                <dt>Humle</dt><dd>${tags(data.hops, 'hop')}</dd>
                <dt>Malt</dt><dd>${tags(data.malts)}</dd>
                <dt>Adjuncts</dt><dd>${tags(data.adjuncts)}</dd>
                <dt>Passer til</dt><dd>${text(data.foodPairing)}</dd>`);
            dialog.showModal();
        }

        $('#beerTable tbody').on('click keydown', 'tr', function (e) {
            if (e.type === 'keydown' && e.key !== 'Enter') return;
            var data = table.row(this).data();
            if (data) openBeer(data);
        });
        $('.d-close').on('click', () => dialog.close());
        dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });

        var bubbles = document.querySelector('.bubbles');
        for (var i = 0; i < 18; i++) {
            var s = document.createElement('span');
            var size = 3 + Math.random() * 6;
            s.style.left = Math.random() * 100 + '%';
            s.style.width = s.style.height = size + 'px';
            s.style.animationDuration = 4 + Math.random() * 6 + 's';
            s.style.animationDelay = -Math.random() * 8 + 's';
            bubbles.appendChild(s);
        }
    });
    </script>
}
