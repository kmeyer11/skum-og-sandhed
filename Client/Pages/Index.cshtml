@page
@model IndexModel

<header class="pour">
    <div class="bubbles" aria-hidden="true"></div>
    <img class="badge" src="~/img/roeverne-maerke.svg" alt="Røverne, Skum og Sandhed" width="200" height="200">
    <h1>Skum og Sandhed</h1>
</header>

<main class="archive">
    <div class="tools">
        <h2>Arkivet <small id="beerCount"></small></h2>
        <div class="filters">
            <select id="yearFilter" class="search year-filter" aria-label="Druk år">
                <option value="">Alle år</option>
            </select>
            <input id="beerSearch" class="search" type="search" placeholder="Søg i navn, bryggeri eller type" aria-label="Søg">
        </div>
    </div>
    <div class="table-wrap">
        <table id="beerTable">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Bryg år</th>
                    <th>Druk år</th>
                    <th class="num">ABV</th>
                    <th>Gæring</th>
                    <th>Gærtype</th>
                    <th class="num">Pris</th>
                    <th>Røverne / Untappd</th>
                </tr>
            </thead>
        </table>
    </div>
</main>

<partial name="_BeerDialog" />

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="~/js/index.js" asp-append-version="true"></script>
}
