@page
@model IndexModel

<header class="pour">
    <div class="bubbles" aria-hidden="true"></div>
    <img class="badge" src="~/img/roeverne-maerke.svg" alt="Røverne, Skum og Sandhed" width="200" height="200">
    <h1>Skum og Sandhed</h1>
</header>

<main class="archive">
    <div class="tools">
        <h2>Arkivet <small id="beerCount"></small></h2>
        <input id="beerSearch" class="search" type="search" placeholder="Søg i navn, bryggeri eller type" aria-label="Søg">
    </div>
    <div class="table-wrap">
        <table id="beerTable">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Bryg år</th>
                    <th>Druk år</th>
                    <th class="num">ABV</th>
                    <th>Gæring</th>
                    <th>Gærtype</th>
                    <th class="num">Pris</th>
                    <th>Røverne / Untappd</th>
                </tr>
            </thead>
        </table>
    </div>
</main>

<partial name="_BeerDialog" />

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
    $(function () {
        var { esc, kr, pct, rating, year, text, openBeer } = Skum;

        function glass(cls, v) {
            var fill = Math.min(Math.max(v / 5, 0), 1) * 100;
            return `<span class="glass ${cls}"><i style="--h:${fill}%"></i>${rating(v)}</span>`;
        }

        $.fn.dataTable.ext.errMode = 'none';

        var table = $('#beerTable').DataTable({
            ajax: { url: '/api/beers', dataSrc: '' },
            dom: 't<"dt-foot"i>',
            paging: false,
            order: [[7, 'desc']],
            language: {
                info: 'Viser _TOTAL_ øl',
                infoEmpty: 'Ingen øl',
                infoFiltered: '(fundet blandt _MAX_)',
                zeroRecords: 'Ingen øl matcher søgningen.',
                emptyTable: 'Arket er tomt.',
                loadingRecords: 'Henter øl fra arket…'
            },
            columns: [
                {
                    data: 'name', className: 'name',
                    render: (d, type, r) => type === 'display'
                        ? `${esc(d)}<span>${esc(r.breweries.join(' & '))}</span>`
                        : type === 'filter' ? [d, ...r.breweries, ...r.types].join(' ') : d
                },
                { data: 'releaseYear', render: (d, type) => type === 'display' ? year(d) : d },
                { data: 'drinkingYear', render: (d, type) => type === 'display' ? year(d) : d },
                { data: 'abv', className: 'num', render: (d, type) => type === 'display' ? pct(d) : d },
                { data: 'fermentation', render: (d, type) => type === 'display' ? text(d) : d },
                { data: 'yeastType', render: (d, type) => type === 'display' ? text(d) : d },
                { data: 'price', className: 'num', render: (d, type) => type === 'display' ? kr(d) : d },
                {
                    data: 'rating',
                    render: (d, type, r) => type === 'display'
                        ? `<span class="glasses">${glass('r', d)}${glass('u', r.untappdRating)}</span>`
                        : d
                }
            ],
            createdRow: row => { row.tabIndex = 0; },
            drawCallback: function () {
                $('#beerCount').text(this.api().page.info().recordsDisplay + ' øl');
            }
        });

        table.on('error.dt', function () {
            $('#beerTable tbody').html('<tr><td colspan="8" class="dataTables_empty">Kunne ikke hente øl fra arket. Genindlæs siden, eller tjek at Google-arket er delt med service accounten.</td></tr>');
        });

        $('#beerSearch').on('input', function () { table.search(this.value).draw(); });

        $('#beerTable tbody').on('click keydown', 'tr', function (e) {
            if (e.type === 'keydown' && e.key !== 'Enter') return;
            var data = table.row(this).data();
            if (data) openBeer(data);
        });
    });
    </script>
}
