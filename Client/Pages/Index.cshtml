@page
@model IndexModel
@{
    ViewData["Title"] = "Hjem";
}

<div class="text-center mb-4">
    <p>Røverne Præsenterer...</p>
    <h1 class="display-4">Skum og Sandhed</h1>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<style>
    #beerTable tbody tr:hover {
        cursor: pointer;
        background-color: #f0f0f0;
    }
    .badge-list span {
        margin-right: 4px;
    }
</style>

<table id="beerTable" class="display table table-striped">
    <thead>
        <tr>
            <th>Navn</th>
            <th>Bryg År</th>
            <th>Druk År</th>
            <th>ABV</th>
            <th>Gæring</th>
            <th>Gærings Type</th>
            <th>Pris</th>
            <th>Røvernes Rating</th>
            <th>Untappd Rating</th>
        </tr>
    </thead>
</table>

<!-- Bootstrap Modal -->
<div class="modal fade" id="beerModal" tabindex="-1" aria-labelledby="beerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="beerModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><strong>Bryggerier:</strong> <span id="beerBreweries"></span></p>
        <p><strong>År Brygget:</strong> <span id="beerReleaseYear"></span></p>
        <p><strong>År Drukket:</strong> <span id="beerDrinkingYear"></span></p>
        <p><strong>ABV:</strong> <span id="beerAbv"></span></p>
        <p><strong>Fermentation:</strong> <span id="beerFermentation"></span></p>
        <p><strong>Gærtype:</strong> <span id="beerYeastType"></span></p>
        <p><strong>Pris:</strong> <span id="beerPrice"></span></p>
        <p><strong>Røvernes Rating:</strong> <span id="beerRating"></span></p>
        <p><strong>Untappd Rating:</strong> <span id="beerUntappdRating"></span></p>
        <p><strong>Food Pairing:</strong> <span id="beerFoodPairing"></span></p>
        <p><strong>Description:</strong> <span id="beerDescription"></span></p>

        <p><strong>Hops:</strong> <span id="beerHops" class="badge-list"></span></p>
        <p><strong>Malts:</strong> <span id="beerMalts" class="badge-list"></span></p>
        <p><strong>Adjuncts:</strong> <span id="beerAdjuncts" class="badge-list"></span></p>
        <p><strong>Types:</strong> <span id="beerTypes" class="badge-list"></span></p>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
    $(document).ready(function() {
        var table = $('#beerTable').DataTable({
            ajax: {
                url: '/api/beers',
                dataSrc: ''
            },
            columns: [
                { data: 'name' },
                { data: 'releaseYear' },
                { data: 'drinkingYear' },
                { data: 'abv' },
                { data: 'fermentation' },
                { data: 'yeastType' },
                { data: 'price' },
                { data: 'rating' },
                { data: 'untappdRating' }
            ]
        });

        // Funktion til badges
        function createBadges(list) {
            return list.map(x => `<span class="badge bg-secondary">${x}</span>`).join(' ');
        }

        // Click event
        $('#beerTable tbody').on('click', 'tr', function () {
            var data = table.row(this).data();
            if (!data) return;

            $('#beerModalLabel').text(data.name);
            $('#beerBreweries').text(data.breweries.join(', '));
            $('#beerReleaseYear').text(data.releaseYear);
            $('#beerDrinkingYear').text(data.drinkingYear);
            $('#beerAbv').text(data.abv);
            $('#beerFermentation').text(data.fermentation ?? '');
            $('#beerYeastType').text(data.yeastType ?? '');
            $('#beerPrice').text(data.price);
            $('#beerRating').text(data.rating);
            $('#beerUntappdRating').text(data.untappdRating);
            $('#beerFoodPairing').text(data.foodPairing ?? '');
            $('#beerDescription').text(data.description ?? '');

            $('#beerHops').html(createBadges(data.hops));
            $('#beerMalts').html(createBadges(data.malts));
            $('#beerAdjuncts').html(createBadges(data.adjuncts));
            $('#beerTypes').html(createBadges(data.types));

            var modal = new bootstrap.Modal(document.getElementById('beerModal'));
            modal.show();
        });
    });
    </script>
}
