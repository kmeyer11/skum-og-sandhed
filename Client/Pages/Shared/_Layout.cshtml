<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title} – Skum og Sandhed" : "Skum og Sandhed")</title>
    <link rel="icon" href="~/img/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/img/roeverne-ikon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    @{ var currentPage = ViewContext.RouteData.Values["page"] as string; }
    <nav class="site-nav" aria-label="Hovedmenu">
        <a class="home" href="~/"><img src="~/img/roeverne-ikon.svg" alt="" width="28" height="28">Skum og Sandhed</a>
        <a href="~/" aria-current="@(currentPage == "/Index" ? "page" : null)">Arkivet</a>
        <a href="~/Statistik" aria-current="@(currentPage == "/Statistik" ? "page" : null)">Statistik</a>
        <a href="~/Pejs" aria-current="@(currentPage == "/Pejs" ? "page" : null)">Pejsen</a>
    </nav>

    @RenderBody()

    <footer class="site-footer">Data fra Røvernes regneark.</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
